<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_dark"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/btn_minus"
        android:layout_width="34dp"
        android:layout_height="44dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_decrease"
        android:padding="7dp"
        android:src="@drawable/ic_minus" />

    <LinearLayout
        android:id="@+id/group_km"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/txt_km_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:text="10.0"
            android:textColor="@color/dark_text_primary"
            android:textSize="23sp" />

        <TextView
            android:id="@+id/txt_km_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:text="@string/unit_km"
            android:textColor="@color/dark_text_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/img_ruler"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_weight="1"
        android:contentDescription="@string/cd_ruler"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:id="@+id/group_mi"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/txt_mi_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:text="6.2"
            android:textColor="@color/cyan_accent_dark"
            android:textSize="23sp" />

        <TextView
            android:id="@+id/txt_mi_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:text="@string/unit_mi"
            android:textColor="@color/dark_text_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/btn_plus"
        android:layout_width="34dp"
        android:layout_height="44dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_increase"
        android:padding="7dp"
        android:src="@drawable/ic_plus" />

    <ImageView
        android:id="@+id/btn_theme"
        android:layout_width="36dp"
        android:layout_height="44dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_toggle_theme"
        android:padding="6dp"
        android:src="@drawable/ic_sun" />
</LinearLayout>
